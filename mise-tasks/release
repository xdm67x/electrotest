#!/usr/bin/env bash
#MISE description="Release: bump Cargo.toml/Cargo.lock to MAJOR.MINOR.PATCH, regenerate CHANGELOG.md, commit, tag vX.Y.Z, push main + tag"
set -euo pipefail

usage() {
  echo "usage: mise run release <major> <minor> <patch>"
}

if [ "$#" -ne 3 ]; then
  echo "error: expected exactly 3 arguments (major minor patch)" >&2
  usage >&2
  exit 1
fi

MAJOR="$1" MINOR="$2" PATCH="$3"
for part in "$MAJOR" "$MINOR" "$PATCH"; do
  if ! [[ "$part" =~ ^[0-9]+$ ]]; then
    echo "error: '$part' is not a non-negative integer" >&2
    exit 1
  fi
done

VERSION="$MAJOR.$MINOR.$PATCH"
TAG="v$VERSION"

# Pre-flight checks: releases are cut from a clean main branch, one tag per version.
BRANCH="$(git branch --show-current)"
if [ "$BRANCH" != "main" ]; then
  echo "error: releases must be cut from main (currently on: ${BRANCH:-<detached>})" >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "error: working tree is not clean; commit or stash your changes first" >&2
  exit 1
fi

if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
  echo "error: tag $TAG already exists" >&2
  exit 1
fi

CURRENT_VERSION="$(grep -m1 '^version = "' Cargo.toml | sed 's/^version = "\(.*\)"/\1/')"
if [ -z "$CURRENT_VERSION" ]; then
  echo "error: could not read the current version from Cargo.toml" >&2
  exit 1
fi
if [ "$CURRENT_VERSION" = "$VERSION" ]; then
  echo "error: Cargo.toml is already at version $VERSION" >&2
  exit 1
fi

echo "Releasing $CURRENT_VERSION -> $VERSION"

# Replace only the first line-start `version = "..."` (the [package] version);
# dependency versions are mid-line and never match.
NEW_VERSION="$VERSION" perl -pi -e 'if (/^version = "/ && !$done) { s/^version = ".*"/version = "$ENV{NEW_VERSION}"/; $done = 1 }' Cargo.toml

BUMPED="$(grep -m1 '^version = "' Cargo.toml | sed 's/^version = "\(.*\)"/\1/')"
if [ "$BUMPED" != "$VERSION" ]; then
  echo "error: failed to update Cargo.toml (still at '$BUMPED')" >&2
  exit 1
fi

# Sync the workspace member version in Cargo.lock without touching dependencies.
cargo update --workspace

# Regenerate CHANGELOG.md with a new section listing all commits since the last tag.
LAST_TAG="$(git describe --tags --abbrev=0 2>/dev/null || true)"
TODAY="$(date +%Y-%m-%d)"
SECTION_FILE="$(mktemp)"
trap 'rm -f "$SECTION_FILE"' EXIT
{
  echo "## [$VERSION] - $TODAY"
  echo
  echo "### Changes"
  if [ -n "$LAST_TAG" ]; then
    git log "$LAST_TAG"..HEAD --pretty=format:"- %s" --no-merges
  else
    git log --pretty=format:"- %s" --no-merges
  fi
  echo
  echo
  if [ -n "$LAST_TAG" ]; then
    echo "**Full Changelog**: https://github.com/xdm67x/electrotest/compare/$LAST_TAG...$TAG"
  else
    echo "**Full Changelog**: https://github.com/xdm67x/electrotest/releases/tag/$TAG"
  fi
  echo
} > "$SECTION_FILE"

# Insert the new section before the first existing version heading;
# create the file with its header if this is the very first changelog.
if [ ! -f CHANGELOG.md ]; then
  printf '# Changelog\n\nAll notable changes to this project will be documented in this file.\n\n' > CHANGELOG.md
fi
INSERT_AT="$(grep -n -m1 '^## ' CHANGELOG.md | cut -d: -f1 || true)"
if [ -n "$INSERT_AT" ]; then
  TMP_CHANGELOG="$(mktemp)"
  head -n $((INSERT_AT - 1)) CHANGELOG.md > "$TMP_CHANGELOG"
  cat "$SECTION_FILE" >> "$TMP_CHANGELOG"
  tail -n +"$INSERT_AT" CHANGELOG.md >> "$TMP_CHANGELOG"
  mv "$TMP_CHANGELOG" CHANGELOG.md
else
  cat "$SECTION_FILE" >> CHANGELOG.md
fi

git add Cargo.toml Cargo.lock CHANGELOG.md
git commit -m "chore: bump version to $VERSION"
git tag -a "$TAG" -m "Release $TAG"

git push origin main
git push origin "$TAG"

echo "Released $TAG — release CI: https://github.com/xdm67x/electrotest/actions/workflows/release.yml"
